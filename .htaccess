# Aktifkan mod_rewrite
RewriteEngine On

# Jika file atau direktori benar-benar ada, jangan rewrite
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Rewrite URL tanpa .php ke file .php
RewriteRule ^([a-zA-Z0-9_-]+)$ $1.php [L]

# Juga tangani URL dengan parameter query (contoh: manage_users?role=teacher)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)$ $1.php [QSA,L]

<IfModule mod_headers.c>
    SetEnvIf Origin "https://almardliyah.infinityfreeapp.com" AccessControlAllowOrigin=$0
    Header set Access-Control-Allow-Origin %{AccessControlAllowOrigin}e env=AccessControlAllowOrigin
    Header set Access-Control-Allow-Credentials true
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# PWA
<FilesMatch "manifest\.json$">
    Header set Content-Type "application/manifest+json"
</FilesMatch>
<FilesMatch "sw\.js$">
    Header set Service-Worker-Allowed "/"
    Header set Cache-Control "no-cache"
</FilesMatch>